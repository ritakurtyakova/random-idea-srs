
@startuml

left to right direction

actor Пользователь as User

rectangle "Генератор случайных идей" {

  usecase "Генерация случайной идеи" as Generate

  usecase "Настройка параметров генерации" as Settings

  usecase "Сохранение идеи в избранное" as Save

  usecase "Просмотр истории генераций" as ViewHistory

  usecase "Копирование идеи" as Copy

  usecase "Удаление идеи из избранного" as Delete

  usecase "Очистка истории" as ClearHistory

  usecase "Экспорт избранного" as Export

  usecase "Экспорт в TXT" as TXT

  ' Include relationships

  Generate .> Settings : <<include>>

  ' Extend relationships

  Export <.. TXT : <<extend>>


}

' Actor associations

User -- Generate

User -- Settings

User -- Save

User -- ViewHistory

User -- Copy

User -- Delete

User -- ClearHistory

User -- Export

@enduml
